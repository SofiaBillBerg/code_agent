# Copy this file to `.env` and adjust values for your environment.
# `.env` is gitignored; this template is committed as a reference.
# All values are optional - the application has safe defaults.
# Every key is prefixed with BERG_AGENT_ so it never collides with the
# provider's own environment variables (e.g. Ollama's OLLAMA_HOST).

# Ollama connection (defaults: http://localhost:11434)
BERG_AGENT_OLLAMA_SCHEME=http
BERG_AGENT_OLLAMA_HOST=localhost
BERG_AGENT_OLLAMA_PORT=11434
BERG_AGENT_OLLAMA_MODEL=gpt-oss:20b-cloud

# OpenAI (optional; when omitted, OpenAIProvider falls back to OPENAI_API_KEY)
BERG_AGENT_OPENAI_API_KEY=
BERG_AGENT_OPENAI_MODEL=gpt-4o
BERG_AGENT_OPENAI_BASE_URL=

# Sampling / behavior
BERG_AGENT_PROVIDER=ollama
BERG_AGENT_TEMPERATURE=0.7
BERG_AGENT_MAX_TOKENS=6000
BERG_AGENT_STREAM=true
BERG_AGENT_ROOT_DIR=.
BERG_AGENT_VERBOSE=true
BERG_AGENT_LOG_LEVEL=INFO
BERG_AGENT_MAX_ITERATIONS=50
BERG_AGENT_MAX_EXECUTION_TIME=5000
