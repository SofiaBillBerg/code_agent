{
  //# DeepAgents configuration file (JSONC format, comments allowed).
  "COHERE_API_KEY": "${env:COHERE_API_KEY}",
  "COHERE_BASE_URL": "${env:COHERE_BASE_URL}",
  "COHERE_MODEL": "${env:COHERE_MODEL}",
  "COHERE_SERVER_PORT": "${env:COHERE_SERVER_PORT}",
  "CODE_AGENT_OPENAI_API_KEY": "${env:CODE_AGENT_OPENAI_API_KEY}",
  "CODE_AGENT_OPENAI_MODEL": "${env:CODE_AGENT_OPENAI_MODEL}",
  "CODE_AGENT_OPENAI_BASE_URL": "${env:CODE_AGENT_OPENAI_BASE_URL}",
  "CODE_AGENT_OLLAMA_SCHEME": "${env:CODE_AGENT_OLLAMA_SCHEME}",
  "CODE_AGENT_OLLAMA_HOST": "${env:CODE_AGENT_OLLAMA_HOST}",
  "CODE_AGENT_OLLAMA_PORT": "${env:CODE_AGENT_OLLAMA_PORT}",
  "CODE_AGENT_OLLAMA_MODEL": "${env:CODE_AGENT_OLLAMA_MODEL}",
  "CODE_AGENT_TEMPERATURE": 0.7,
  "CODE_AGENT_STREAM": true,
  "CODE_AGENT_ROOT_DIR": "${env:CODE_AGENT_ROOT_DIR}",
  "CODE_AGENT_VERBOSE": true,
  "CODE_AGENT_LOG_LEVEL": "info",
  "CODE_AGENT_MCP_SERVERS": "config/.mcp.json",
  //# DeepAgents skills: JSON array of paths (or [path, label] pairs) to
  //# SKILL.md directories, loaded progressively by the harness.
  //# Paths must live under the mounted workspace (CODE_AGENT_ROOT_DIR).
  //"CODE_AGENT_SKILLS": "[\"skills/code-conventions\"]",

  //# DeepAgents memory: JSON array of AGENTS.md file paths, always loaded.
  //"CODE_AGENT_MEMORY": "[\"AGENTS.md\"]",

  //# DeepAgents todo list: when true (default) the agent gets a write_todos
  //# tool to maintain a structured task list during execution.
  //"CODE_AGENT_TODOS_ENABLED": true,

  //# DeepAgents summarization trigger (context offloading threshold).
  //# One of: ["fraction", 0.85] | ["messages", 50] |
  //#         [["fraction", 0.8], ["messages", 100]] (OR list) |
  //#         [{"tokens": 4000, "messages": 10}] (AND clause)
  //"CODE_AGENT_SUMMARIZATION_TRIGGER": "[\"fraction\", 0.85]",

  //# Context retention after summarization, e.g. ["messages", 20].
  //"CODE_AGENT_SUMMARIZATION_KEEP": "[\"messages\", 20]",

  //# MCP server secrets (git-ignored; referenced as ${VAR} in .mcp.json)
  "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_PERSONAL_ACCESS_TOKEN}",
  "CONTEXT7_API_KEY": "${env:CONTEXT7_API_KEY}"
}
